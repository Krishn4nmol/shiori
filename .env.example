# Copy to .env and fill in. Never commit .env.

DATABASE_URL=postgresql+asyncpg://shiori:shiori@127.0.0.1:5432/shiori
REDIS_URL=redis://127.0.0.1:6379/0

# LLM: pick ONE block below and paste the free API key where needed. ------------------------

# 1) Google Gemini, free tier (best quality for free, strong Japanese). No credit card.
#    Get a key at https://aistudio.google.com/apikey
#    Free-tier prompts may be used by Google to improve its products: don't upload
#    confidential papers with this option.
LLM_PROVIDER=openai
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=

# 2) Local and private, unlimited, no account (slower on a CPU-only laptop).
#    Install Ollama (https://ollama.com), then: ollama pull qwen3:4b
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen3:4b
# LLM_API_KEY=

# 3) Groq, free tier (very fast). Key at https://console.groq.com/keys
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_API_KEY=

# 4) Anthropic API (paid)
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-haiku-5-5
# LLM_EFFORT=medium
# ANTHROPIC_API_KEY=

# Embeddings run locally on CPU
EMBEDDING_MODEL=BAAI/bge-m3

# Auth: signs session cookies. Keep secret; changing it logs everyone out.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# COOKIE_SECURE=true   # when served over HTTPS

# Knowledge graph (Neo4j, from docker-compose)
NEO4J_URL=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=shiori-graph
