# Production settings for docker-compose.prod.yml. Copy to .env.production (git-ignored)
# and fill in every secret. Generate strong values with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# Where the app is served. A domain name (shiori.your-lab.example) gets HTTPS automatically
# (ports 80 and 443 must reach this machine). ":80" serves plain HTTP on a private network;
# then also set COOKIE_SECURE=false.
SITE_ADDRESS=:80
COOKIE_SECURE=false

POSTGRES_PASSWORD=
NEO4J_PASSWORD=
SECRET_KEY=

# LLM (see README "LLM setup"). Default: Google Gemini free tier.
LLM_PROVIDER=openai
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=
